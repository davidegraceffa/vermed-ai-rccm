# Port the NestJS HTTP + WebSocket server listens on
PORT=3001

# Note: WebSocket CORS is intentionally left wide open (origin: true) in
# grid.gateway.ts for this prototype -- see the comment there for why an
# env-driven allow-list isn't wired up (NestJS gateway decorator options
# are evaluated before ConfigModule loads .env). Lock this down in prod.

# Cooldown window per authorised user, in milliseconds.
# One accepted cell update is allowed per user during this window.
COOLDOWN_MS=10000

# Grid dimensions (kept configurable, spec requires 1000x1000)
GRID_WIDTH=1000
GRID_HEIGHT=1000

# How often accepted cell updates are flushed to connected clients as one
# batched "grid:cells-updated" event, in milliseconds. Decouples broadcast
# frequency from accept-path throughput -- see the comment on
# GridGateway.pendingBroadcast for why this matters at the spec's ~333
# accepted updates/sec peak.
BROADCAST_BATCH_MS=75
