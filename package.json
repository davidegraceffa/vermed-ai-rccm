{
  "name": "regional-care-capacity-map",
  "version": "0.1.0",
  "private": true,
  "author": "Davide Graceffa",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev:open",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "e2e": "pnpm --filter e2e test",
    "load-test": "pnpm --filter scripts load-test",
    "measure-snapshot": "pnpm --filter scripts measure-snapshot"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
